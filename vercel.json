{
  "experimentalServices": {
    "frontend": {
      "entrypoint": ".",
      "framework": "vite",
      "routePrefix": "/"
    },
    "backend": {
      "entrypoint": "api/index.ts",
      "framework": "express",
      "routePrefix": "/api",
      "includeFiles": ["server/**"]
    }
  },
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!api/.*).*)",
      "destination": "/index.html"
    }
  ]
}
