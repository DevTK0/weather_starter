{
  "name": "weather-starter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "dev": "node scripts/dev.mjs",
    "build": "tsc -p tsconfig.json && vite build && tsc -p server/tsconfig.json && tsc -p tsconfig.api.json",
    "preview": "vite preview",
    "start": "node scripts/start.mjs",
    "doctor": "node scripts/doctor.mjs",
    "reset": "node scripts/reset.mjs",
    "test": "NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest run",
    "test:watch": "NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@libsql/client": "^0.17.3",
    "@vitejs/plugin-react": "^5.1.4",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^4.19.2",
    "leaflet": "^1.9.4",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "portless": "^0.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "vite": "^7.3.1"
  },
  "devDependencies": {
    "@frontman-ai/vite": "^0.5.2",
    "@types/express": "^4.17.21",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/supertest": "^7.2.0",
    "@vercel/node": "^5.5.12",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "postcss": "^8.4.49",
    "prettier": "3.8.3",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.59.2",
    "vitest": "^4.1.5"
  }
}
