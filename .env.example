# Optional data.gov.sg API key for higher rate limits.
# Set this in Vercel for production weather refreshes.
WEATHER_API_KEY=your_api_key_here

# Stable local browser URL used by scripts/dev.mjs through Portless.
PORTLESS_PORT=1355
PORTLESS_HTTPS=0

# Turso/libSQL connection for local dev and Vercel deployments.
# DATABASE_URL should be the Turso libSQL URL, for example:
# libsql://your-database-name-your-org.turso.io
DATABASE_URL=libsql://your-database-name-your-org.turso.io
DATABASE_AUTH_TOKEN=your_turso_auth_token
